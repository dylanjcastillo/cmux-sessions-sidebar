// Optional cmux settings that pair well with the Sessions sidebar.
// Merge the parts you want into ~/.config/cmux/cmux.json, then run:
//   cmux config validate && cmux reload-config
{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  "app" : {
    // Hide the workspace title bar above the tabs (the sidebar shows the
    // open project instead).
    "minimalMode" : true,
    // The command palette also matches tab names, not just workspace names.
    "commandPaletteSearchesAllSurfaces" : true,
    // Keep projects where they are when they get a notification (cmux moves
    // them to the top by default).
    "reorderOnNotification" : false
  },

  // Cmd+K searches projects and tabs with fzf (search/cmux-search, installed
  // by install.sh; needs `brew install fzf`). It opens in a new tab, which
  // closes itself when you pick something or press Esc. cmux's own switcher
  // stays on Cmd+P.
  "actions" : {
    "search-projects-and-tabs" : {
      "type" : "command",
      "title" : "Search Projects and Tabs",
      "command" : "exec ~/.config/cmux/bin/cmux-search",
      "target" : "newTabInCurrentPane",
      "shortcut" : "cmd+k",
      "palette" : true
    }
  },

  // Open links in the system default browser instead of the cmux browser.
  "browser" : {
    "interceptTerminalOpenCommandInCmuxBrowser" : false,
    "openTerminalLinksInCmuxBrowser" : false
  },
  "sidebar" : {
    "openPortLinksInCmuxBrowser" : false,
    "openPullRequestLinksInCmuxBrowser" : false
  }
}
