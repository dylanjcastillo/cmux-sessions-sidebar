#!/usr/bin/env python3
"""Search the projects and tabs in this cmux window with fzf, then jump to one.

cmux runs this in a new tab when you press the shortcut set in cmux.json (see
cmux.json.example). The tab closes itself when you pick something or press Esc.

Projects and tabs are listed in the same order as the Sessions sidebar:
projects without a group, then each group, then Archived. The hidden header
workspace of each group is left out, and so is this tab.
"""
import json
import os
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

ARCHIVE_GROUP = "Archive"  # same names as sessions.js
GROUP_HEADER_MARK = "cmux-sessions-sidebar:group-header"

CMUX = shutil.which("cmux") or os.environ.get("CMUX_BUNDLED_CLI_PATH") or "cmux"
SELF = os.environ.get("CMUX_SURFACE_ID", "")

DIM, BLUE, RESET = "\033[2m", "\033[34m", "\033[0m"


def rpc(method, params=None):
    out = subprocess.run(
        [CMUX, "rpc", method, json.dumps(params or {})],
        capture_output=True, text=True, check=True,
    ).stdout
    return json.loads(out)


def branch(ws_id):
    out = subprocess.run(
        [CMUX, "sidebar-state", "--workspace", ws_id],
        capture_output=True, text=True,
    ).stdout
    for line in out.splitlines():
        if line.startswith("git_branch="):
            name = line.split("=", 1)[1].split(" ")[0]
            return "" if name == "none" else name
    return ""


def short_path(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path and path.startswith(home) else (path or "")


def ordered_projects(workspaces, groups):
    """Workspaces in sidebar order, each paired with its group name or None."""
    group_of = {}
    for g in groups:
        for ws_id in g.get("member_workspace_ids", []):
            group_of[ws_id] = g
    visible = [w for w in workspaces if w.get("description") != GROUP_HEADER_MARK]
    by_index = sorted(visible, key=lambda w: w.get("index", 0))

    ungrouped = [(w, None) for w in by_index if w["id"] not in group_of]
    live = [g for g in groups if g["name"] != ARCHIVE_GROUP]
    live = [g for g in live if g.get("is_pinned")] + [g for g in live if not g.get("is_pinned")]
    archive = [g for g in groups if g["name"] == ARCHIVE_GROUP]

    result = list(ungrouped)
    for g in live + archive:
        result += [(w, g["name"]) for w in by_index if group_of.get(w["id"]) is g]
    return result


def build_lines():
    workspaces = rpc("workspace.list")["workspaces"]
    groups = rpc("workspace.group.list").get("groups", [])
    projects = ordered_projects(workspaces, groups)

    with ThreadPoolExecutor(max_workers=16) as pool:
        surfaces = pool.map(lambda p: rpc("surface.list", {"workspace_id": p[0]["id"]})["surfaces"], projects)
        branches = pool.map(lambda p: branch(p[0]["id"]), projects)
        surfaces, branches = list(surfaces), list(branches)

    lines = []
    for (w, group), tabs, br in zip(projects, surfaces, branches):
        name = w.get("title") or "Untitled"
        meta = " · ".join(x for x in [group if group != ARCHIVE_GROUP else "Archived",
                                      br, short_path(w.get("current_directory"))] if x)
        icon = f"{BLUE}▸{RESET}" if w.get("selected") else "▸"
        lines.append(f"ws\t{w['id']}\t\t{icon} {name}  {DIM}{meta}{RESET}")
        for t in sorted(tabs, key=lambda t: t.get("index", 0)):
            if t["id"] == SELF:
                continue
            title = t.get("title") or t.get("type", "tab")
            lines.append(f"tab\t{w['id']}\t{t['id']}\t    {title}  {DIM}{name}{RESET}")
    return lines


def close_self():
    if SELF:
        subprocess.run([CMUX, "rpc", "surface.close", json.dumps({"surface_id": SELF})],
                       capture_output=True)


def main():
    fzf = shutil.which("fzf") or "/opt/homebrew/bin/fzf"
    if not os.path.exists(fzf):
        print("cmux-search needs fzf: brew install fzf")
        input("Press Enter to close.")
        return

    choice = ""
    try:
        lines = build_lines()
        result = subprocess.run(
            [fzf, "--ansi", "--delimiter=\t", "--with-nth=4", "--layout=reverse",
             "--height=100%", "--info=inline-right", "--tiebreak=index",
             "--prompt=Search › ", "--pointer=›", "--no-scrollbar",
             "--color=bg+:-1,gutter:-1,pointer:blue,prompt:blue,hl:blue,hl+:blue"],
            input="\n".join(lines), capture_output=False, stdout=subprocess.PIPE, text=True,
        )
        choice = result.stdout.strip()
    except subprocess.CalledProcessError as e:
        print(f"cmux-search: {e.stderr or e}")
        input("Press Enter to close.")
    except KeyboardInterrupt:
        pass

    if choice:
        kind, ws_id, surface_id = choice.split("\t")[:3]
        if kind == "tab":
            rpc("surface.focus", {"surface_id": surface_id, "workspace_id": ws_id})
        else:
            rpc("workspace.select", {"workspace_id": ws_id})
    close_self()


if __name__ == "__main__":
    sys.exit(main())
